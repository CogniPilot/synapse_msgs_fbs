include "std_msgs/Header.fbs";

const COVARIANCE_TYPE_UNKNOWN:ubyte = 0;
const COVARIANCE_TYPE_APPROXIMATED:ubyte = 1;
const COVARIANCE_TYPE_DIAGONAL_KNOWN:ubyte = 2;
const COVARIANCE_TYPE_KNOWN:ubyte = 3;

table NavSatFix {
  header:std_msgs.Header;
  status:NavSatStatus;
  latitude:double;
  longitude:double;
  altitude:double;
  position_covariance:[double];
  position_covariance_type:ubyte;
}

root_type NavSatFix;